{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trialtrace:evidence:v1",
  "title": "TrialTrace evidence viewer input v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "data_kind",
    "clinical_validation",
    "producer",
    "review_status",
    "source",
    "ruleset",
    "input_files",
    "limitations",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "trialtrace.evidence.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "data_kind": {
      "const": "SYNTHETIC"
    },
    "clinical_validation": {
      "const": false
    },
    "producer": {
      "type": "object",
      "required": [
        "kind",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "CONTRACT_FIXTURE",
            "ARITHMETIC_PROBE",
            "DEMO_ENGINE"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review_status": {
      "enum": [
        "PENDING_TEAM_SOURCE_REVIEW",
        "TEAM_REVIEWED_SYNTHETIC_DEMO"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "url",
        "locator",
        "pdf_sha256",
        "retrieval_status"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "pdf_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha"
            }
          ]
        },
        "retrieval_status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ruleset": {
      "type": "object",
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "input_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "optionalIdentity": {
      "type": [
        "string",
        "null"
      ]
    },
    "calculation": {
      "type": "object",
      "required": [
        "target",
        "earliest",
        "latest",
        "actual",
        "days_outside"
      ],
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "earliest": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "latest": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "actual": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "days_outside": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "finding_id",
        "record_ordinal",
        "participant_id",
        "site_id",
        "visit_id",
        "visit_code",
        "status",
        "reason",
        "calculation",
        "evidence"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "record_ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "participant_id": {
          "$ref": "#/$defs/optionalIdentity"
        },
        "site_id": {
          "$ref": "#/$defs/optionalIdentity"
        },
        "visit_id": {
          "$ref": "#/$defs/optionalIdentity"
        },
        "visit_code": {
          "$ref": "#/$defs/optionalIdentity"
        },
        "status": {
          "enum": [
            "PASS",
            "POTENTIAL_DEVIATION",
            "DATA_QUERY",
            "NOT_EVALUABLE"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "calculation": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/calculation"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "source_file",
              "record_ordinal",
              "sha256",
              "raw_record"
            ],
            "properties": {
              "source_file": {
                "type": "string",
                "minLength": 1
              },
              "record_ordinal": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha"
              },
              "raw_record": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
